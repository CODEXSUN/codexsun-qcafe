{
  "name": "codexsun-local-demo",
  "services": {
    "chat": {
      "image": "node:24-alpine",
      "command": [
        "node",
        "/service/server.mjs"
      ],
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "ports": [
        "127.0.0.1:9051:9051"
      ],
      "volumes": [
        "./server.mjs:/service/server.mjs:ro",
        "chat-state:/state"
      ],
      "environment": {},
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:9051/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
        ],
        "interval": "5s",
        "timeout": "3s",
        "retries": 5
      }
    },
    "image-agent": {
      "image": "node:24-alpine",
      "command": [
        "node",
        "/service/server.mjs"
      ],
