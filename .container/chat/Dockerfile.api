FROM node:24-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/chat/api ./apps/chat/api
RUN npm ci && npm run typecheck -w @codexsun/chat-api

FROM node:24-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/chat/api ./apps/chat/api
EXPOSE 4160
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=5 CMD node -e "fetch('http://127.0.0.1:4160/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "--import", "tsx", "apps/chat/api/src/server.ts"]
