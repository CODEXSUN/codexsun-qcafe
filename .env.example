OS_API_HOST=127.0.0.1
OS_API_PORT=4100
VITE_OS_API_URL=http://127.0.0.1:4100
OPENAI_API_KEY=
DATABASE_URL=
OS_DATABASE_REQUIRED=false
OS_IDENTITY_TOKEN_SECRET=
# Optional Redis transport for platform-owned outbox dispatchers.
OS_REDIS_ENABLED=false
OS_REDIS_URL=
OS_DEV_PORT_POLICY=replace
CODEXSUN_VITE_HOT_RELOAD=false
CODEXSUN_VITE_HMR_POLLING=false
CODEXSUN_VITE_HMR_HOST=
CODEXSUN_VITE_HMR_PORT=
CODEXSUN_VITE_HMR_PROTOCOL=
CODEXSUN_LOCAL_DEMO=false

# Use the built zetro:v1 container for Zetro prompts.
CODEXSUN_ZETRO_DOCKER=false
# Use the first multi-provider agent runtime (zxa:v1) for Zetro prompts.
CODEXSUN_ZXA_DOCKER=false
ZXA_LOCAL_TOKEN=local-zxa-only
ZXA_DEFAULT_PROVIDER=c
ZXA_REQUEST_TIMEOUT_MS=120000
ZXA_CODEX_MODEL=
ZXA_GEMINI_MODEL=gemini-2.5-flash
ZXA_GEMINI_API_KEY=
ZXA_OPENCODE_MODEL=
ZXA_OPENCODE_API_KEY=
ZXA_OPENCODE_BASE_URL=
ZXA_OPENAI_API_KEY=
ZXA_ANTHROPIC_API_KEY=
# Folder Zetro exposes when a project is connected to local files.
# Use forward slashes on Windows. The current repository is used when omitted.
ZETRO_PROJECTS_ROOT=
# Chat standalone module
CHAT_API_HOST=127.0.0.1
CHAT_API_PORT=4165
CHAT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5176,http://tauri.localhost,https://tauri.localhost,tauri://localhost
CHAT_DEMO_TOKEN=local-demo-only
# Development-only loopback endpoint for short-lived in-memory Chat tokens.
CHAT_LOCAL_TOKEN_ISSUER=true

# Optional Zetro JSON settings path; defaults beside the workspace SQLite file.
ZETRO_SETTINGS_FILE=

# Platform VPS integration; server-side secrets only.
HOSTINGER_API_TOKEN=
VPS_ACCESS_TOKEN=

OS_SUPER_ADMIN_PASSWORD=
## Allow one-time password setup using OS_SUPER_ADMIN_PASSWORD as the setup code.
OS_FIRST_LOGIN_SETUP=false
