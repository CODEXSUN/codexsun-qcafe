{
  "name": "codexsun-os",
  "services": {
    "web": {
      "image": "nginx:stable-alpine",
      "container_name": "os-codexsun-web",
      "restart": "unless-stopped",
      "read_only": true,
      "volumes": [
        "./portal:/usr/share/nginx/html:ro",
        "./nginx.conf:/etc/nginx/conf.d/default.conf:ro"
      ],
      "tmpfs": [
        "/var/cache/nginx",
        "/var/run",
        "/tmp"
      ],
      "networks": [
        "edge",
        "internal"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "depends_on": {
        "platform": {
          "condition": "service_healthy"
        },
        "zetro": {
          "condition": "service_healthy"
        },
        "chat": {
          "condition": "service_healthy"
        },
        "docs": {
          "condition": "service_healthy"
        },
        "dcs": {
          "condition": "service_healthy"
        }
      }
    },
    "dcs": {
      "image": "codexsun-os/dcs:${CODEXSUN_VERSION:-0.1.22}",
      "restart": "unless-stopped",
      "build": {
        "context": "..",
        "dockerfile": "packages/dcs/Dockerfile"
      },
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "volumes": [
        "./state/dcs:/data",
        "./config:/config:ro"
      ],
      "networks": [
        "internal"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:4170/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 5
      },
      "env_file": [
        "./config/dcs.env"
      ],
      "depends_on": {
        "platform": {
          "condition": "service_healthy"
        }
      }
    },
    "platform": {
      "image": "codexsun-os/api:${CODEXSUN_VERSION:-0.1.22}",
      "restart": "unless-stopped",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "env_file": [
        "./config/platform.env"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "networks": [
        "internal",
        "edge"
      ],
      "build": {
        "context": "..",
        "dockerfile": "deploy/Dockerfile.api"
      },
      "command": [
        "node",
        "build/platform.mjs"
      ],
      "environment": {
        "OS_PUBLIC_BASE_URL": "https://os.codexsun.com"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch(\"http://127.0.0.1:4100/health\").then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 5
      }
    },
    "zetro": {
      "image": "codexsun-os/api:${CODEXSUN_VERSION:-0.1.22}",
      "restart": "unless-stopped",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "env_file": [
        "./config/zetro.env"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "networks": [
        "internal",
        "edge"
      ],
      "command": [
        "node",
        "build/zetro.mjs"
      ],
      "volumes": [
        "./state/zetro:/data",
        "./state/projects:/projects",
        "./config/agents.json:/config/agents.json:ro"
      ],
      "depends_on": {
        "platform": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch(\"http://127.0.0.1:4150/health\").then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 5
      }
    },
    "chat": {
      "image": "codexsun-os/api:${CODEXSUN_VERSION:-0.1.22}",
      "restart": "unless-stopped",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "env_file": [
        "./config/chat.env"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "networks": [
        "internal",
        "edge"
      ],
      "command": [
        "node",
        "build/chat.mjs"
      ],
      "depends_on": {
        "platform": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch(\"http://127.0.0.1:4165/health\").then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 5
      }
    },
    "docs": {
      "image": "codexsun-os/api:${CODEXSUN_VERSION:-0.1.22}",
      "restart": "unless-stopped",
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "command": ["node", "build/docs.mjs"],
      "env_file": ["./config/platform.env"],
      "environment": {
        "DOCS_API_HOST": "0.0.0.0",
        "DOCS_CONTENT_DIRECTORY": "/app/docs-content",
        "OS_IDENTITY_URL": "http://platform:4100"
      },
      "networks": ["internal"],
      "depends_on": {
        "platform": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": ["CMD", "node", "-e", "fetch('http://127.0.0.1:4185/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"],
        "interval": "15s",
        "timeout": "5s",
        "retries": 5
      }
    },
    "files": {
      "image": "cxapp/media:1.0.44-filebrowser2.63.5",
      "entrypoint": [
        "filebrowser"
      ],
      "command": [
        "--address",
        "0.0.0.0",
        "--port",
        "80",
        "--root",
        "/srv",
        "--database",
        "/database/filebrowser.db",
        "--baseURL",
        "/files"
      ],
      "user": "1000:1000",
      "restart": "unless-stopped",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "volumes": [
        "./state/projects:/srv",
        "./state/filebrowser:/database"
      ],
      "networks": [
        "internal"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-q",
          "--spider",
          "http://127.0.0.1:80/files/health"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 5
      }
    },
    "zxa": {
      "image": "codexsun-os/zxa:v1",
      "build": {
        "context": "..",
        "dockerfile": "packages/zxa/docker/Dockerfile"
      },
      "restart": "unless-stopped",
      "init": true,
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "env_file": [
        "./config/zxa.env"
      ],
      "tmpfs": [
        "/tmp:rw,nosuid,size=256m"
      ],
      "volumes": [
        "zxa-state:/state",
        "zxa-runtime:/runtime",
        "zxa-workspace:/workspace"
      ],
      "networks": [
        "internal",
        "edge"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch(\"http://127.0.0.1:4200/health\").then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 5
      }
    }
  },
  "networks": {
    "edge": {
      "external": true,
      "name": "cxapp-network"
    },
    "internal": {
      "internal": true
    }
  },
  "volumes": {
    "zxa-state": {},
    "zxa-runtime": {},
    "zxa-workspace": {}
  }
}
