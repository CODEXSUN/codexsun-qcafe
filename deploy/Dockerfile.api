FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY . .
RUN npm ci --include=dev && node -e "const D=require('better-sqlite3'); new D(':memory:').close()" && node deploy/build-services.mjs && npm prune --omit=dev --ignore-scripts

FROM node:24-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/deploy/build ./build
COPY --from=build /app/apps/docs/content ./docs-content
USER node
CMD ["node", "build/platform.mjs"]
