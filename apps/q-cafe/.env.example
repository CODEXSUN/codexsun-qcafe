# Q Cafe owns this configuration. Copy to apps/q-cafe/.env for a local Windows installation.
QCAFE_DATABASE_PATH=.local/q-cafe.sqlite
QCAFE_API_PORT=4180
QCAFE_WEB_PORT=5180
QCAFE_DEMO=true
QCAFE_CASHIER_PIN=1234
# Leave unset for local development. The launcher creates a private operator key.
# QCAFE_API_TOKEN=
# Future cloud sync endpoint. This release only records pending SQLite changes.
QCAFE_SYNC_URL=
