!macro NSIS_HOOK_PREINSTALL
  nsExec::ExecToStack '"$SYSDIR\taskkill.exe" /F /T /IM q-cafe-desktop.exe'
  Pop $0
  Pop $1
  nsExec::ExecToStack '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand '
  Pop $0
  Pop $1
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  nsExec::ExecToStack '"$SYSDIR\taskkill.exe" /F /T /IM q-cafe-desktop.exe'
  Pop $0
  Pop $1
  nsExec::ExecToStack '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand '
  Pop $0
  Pop $1
  RMDir /r "$LOCALAPPDATA\Q Cafe\codexsun-services"
  RMDir /r "$LOCALAPPDATA\Q Cafe\runtime\codexsun-services"
  Delete "$LOCALAPPDATA\Q Cafe\codexsun-services.json"
!macroend
