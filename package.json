{
  "name": "codexsun-os",
  "version": "0.1.27",
  "private": true,
  "description": "CODEXSUN application core and agent-first orchestration runtime",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/platform/*/*",
    "apps/*/web",
    "apps/*/api",
    "apps/*/desktop",
    "packages/*",
    "packages/*/*"
  ],
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "assist:doctor": "node tools/assist-doctor.mjs",
    "assist:validate": "node tools/assist-doctor.mjs --strict",
    "build": "npm run build --workspaces --if-present",
    "build:q-cafe": "npm run build -w @codexsun/q-cafe-web",
    "build:neot": "npm run build -w @codexsun/neot-web",
    "build:desktop": "npm run build -w @codexsun/core-desktop",
    "build:desktop:web": "node tools/build-codexsun-desktop-web.mjs",
    "build:q-cafe:windows": "npm.cmd --prefix apps/q-cafe/desktop run build && node tools/package-q-cafe-desktop.mjs",
    "check": "npm run assist:validate && npm run check:versions && npm run test:tools && npm run typecheck --workspaces --if-present && npm run test --workspaces --if-present",
    "check:versions": "node tools/check-versions.mjs",
    "changelog:append": "node tools/version/version.mjs append",
    "dev": "node tools/dev-stack.mjs",
    "dev:q-cafe": "node tools/start-q-cafe.mjs",
    "dev:neot": "node tools/start-neot.mjs",
    "dev:q-cafe:desktop": "npm.cmd --prefix apps/q-cafe/desktop run dev",
    "dev:q-cafe:windows": "npm.cmd --prefix apps/q-cafe/desktop run dev",
    "dev:api": "node tools/start-service.mjs api",
    "dev:preflight": "node tools/preflight.mjs",
    "dev:devkit": "node tools/start-service.mjs devkit",
    "dev:desktop": "npm run dev -w @codexsun/core-desktop",
    "dev:chat": "concurrently --names chat-api,chat-web \"npm:dev:chat-api\" \"npm:dev:chat-web\"",
    "dev:chat-api": "node tools/start-service.mjs chat-api",
    "dev:chat-web": "node tools/start-service.mjs chat",
    "dev:zetro": "node tools/start-service.mjs zetro",
    "dev:zetro-api": "node tools/start-service.mjs zetro-api",
    "dev:web": "node tools/start-service.mjs web",
    "github:now": "node tools/github-helper.mjs",
    "identity:first-login-close": "node tools/close-first-login-setup.mjs",
    "identity:first-login-code": "node tools/generate-first-login-code.mjs",
    "identity:first-login-sync": "powershell -ExecutionPolicy Bypass -File deploy/sync-first-login-setup.ps1",
    "check:desktop": "npm run check -w @codexsun/core-desktop",
    "q-cafe:token": "node tools/q-cafe-token.mjs --replace",
    "release:daily": "powershell -ExecutionPolicy Bypass -File deploy/release-routine.ps1",
    "release:notify": "node deploy/notify-release.mjs",
    "release:status": "powershell -ExecutionPolicy Bypass -File deploy/watch-vps-release.ps1",
    "neot:token": "node tools/neot-token.mjs --replace",
    "start": "npm run start -w @codexsun/core-api",
    "test:tools": "node --test tools/*.test.mjs",
    "version:bump": "node tools/version-bump.mjs",
    "version:show": "node tools/version/version.mjs show",
    "zxa:build": "npm run build -w @codexsun/zxa-web && docker compose -f packages/zxa/docker/compose.json build",
    "zxa:setup": "powershell -ExecutionPolicy Bypass -File packages/zxa/docker/setup-zxa.ps1",
    "zxa:up": "docker compose -f packages/zxa/docker/compose.json up -d --wait",
    "zxa:down": "docker compose -f packages/zxa/docker/compose.json down",
    "zetro:desk": "npm run desk -w @codexsun/zetro-local-runner -- --docker"
  },
  "devDependencies": {
    "concurrently": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
